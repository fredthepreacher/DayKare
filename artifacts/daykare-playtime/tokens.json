{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "DayKare Playtime design tokens extracted from the DayKare game UI. The token file is the source of truth; generated CSS and portable tokens are rebuilt from it.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fdfbf7", "$description": "Warm paper canvas." },
      "foreground": { "$value": "#5c3a21", "$description": "Cocoa default text." },
      "border": { "$value": "#dfcbb8", "$description": "Soft paper edge." },
      "card": { "$value": "#fffdf8", "$description": "Raised paper surface." },
      "cardForeground": { "$value": "#5c3a21" },
      "popover": { "$value": "#fffdf8" },
      "popoverForeground": { "$value": "#5c3a21" },
      "primary": {
        "$value": "#ffad33",
        "$description": "Sunny primary action color used for Story Mode and rewards."
      },
      "primaryForeground": { "$value": "#5c3300" },
      "secondary": {
        "$value": "#33cccc",
        "$description": "Playground teal for connected-feeling secondary actions."
      },
      "secondaryForeground": { "$value": "#004d4d" },
      "muted": { "$value": "#f4ece1" },
      "mutedForeground": { "$value": "#725845" },
      "accent": {
        "$value": "#ff66b3",
        "$description": "Imagination pink for customization and expressive moments."
      },
      "accentForeground": { "$value": "#660033" },
      "destructive": { "$value": "#d62828" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#dfcbb8" },
      "ring": { "$value": "#33cccc" },
      "chart1": { "$value": "#ffad33" },
      "chart2": { "$value": "#33cccc" },
      "chart3": { "$value": "#ff66b3" },
      "chart4": { "$value": "#3a86ff" },
      "chart5": { "$value": "#06d6a0" },
      "sidebar": { "$value": "#f4ece1" },
      "sidebarForeground": { "$value": "#5c3a21" },
      "sidebarBorder": { "$value": "#d4c3b3" },
      "sidebarPrimary": { "$value": "#5c3a21" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#fffdf8" },
      "sidebarAccentForeground": { "$value": "#5c3a21" },
      "sidebarRing": { "$value": "#33cccc" }
    },
    "dark": {
      "background": { "$value": "#2f241e", "$description": "Derived dark cocoa canvas." },
      "foreground": { "$value": "#fff7e8" },
      "border": { "$value": "#765746" },
      "card": { "$value": "#45342a" },
      "cardForeground": { "$value": "#fff7e8" },
      "popover": { "$value": "#45342a" },
      "popoverForeground": { "$value": "#fff7e8" },
      "primary": { "$value": "#ffb84d" },
      "primaryForeground": { "$value": "#4a2e1b" },
      "secondary": { "$value": "#42d6d4" },
      "secondaryForeground": { "$value": "#003b3b" },
      "muted": { "$value": "#5e483b" },
      "mutedForeground": { "$value": "#e5cdb8" },
      "accent": { "$value": "#ff80bf" },
      "accentForeground": { "$value": "#4d0026" },
      "destructive": { "$value": "#f06a5f" },
      "destructiveForeground": { "$value": "#3a160f" },
      "input": { "$value": "#765746" },
      "ring": { "$value": "#8ff5f1" },
      "chart1": { "$value": "#ffb84d" },
      "chart2": { "$value": "#42d6d4" },
      "chart3": { "$value": "#ff80bf" },
      "chart4": { "$value": "#6d9dff" },
      "chart5": { "$value": "#51e0b4" },
      "sidebar": { "$value": "#3b2b24" },
      "sidebarForeground": { "$value": "#fff7e8" },
      "sidebarBorder": { "$value": "#765746" },
      "sidebarPrimary": { "$value": "#ffb84d" },
      "sidebarPrimaryForeground": { "$value": "#4a2e1b" },
      "sidebarAccent": { "$value": "#514037" },
      "sidebarAccentForeground": { "$value": "#fff7e8" },
      "sidebarRing": { "$value": "#8ff5f1" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Plus Jakarta Sans", "Inter", "sans-serif"],
        "$description": "Friendly, sturdy UI and body face."
      },
      "serif": {
        "$value": ["Fraunces", "Georgia", "serif"],
        "$description": "Expressive story headings and journal titles."
      },
      "mono": {
        "$value": ["Space Mono", "monospace"],
        "$description": "Compact technical or status readouts."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "The source uses rounded 16px controls, with larger 22–30px panel corners."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base rhythm; common layout steps are 12, 16, 24, and 32px."
    }
  }
}